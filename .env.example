# Copy to .env and fill in.
# These are read by app.config.ts (or app.json extra block) and exposed
# to the client. NEVER put provider API keys here; only the public
# Supabase anon key. AI provider keys live in Supabase edge functions.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Edge function secrets (set with: supabase secrets set ...)
# Not used by the client. Listed here for reference.
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
