{
  "expo": {
    "name": "SnapStudy",
    "slug": "snapstudy",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "snapstudy",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0F19"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.snapstudy.client",
      "infoPlist": {
        "NSCameraUsageDescription": "SnapStudy uses the camera to capture notes and textbook pages so it can turn them into flashcards.",
        "NSPhotoLibraryUsageDescription": "SnapStudy reads selected photos so it can generate flashcards from them."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0F19"
      },
      "package": "app.snapstudy.client",
      "permissions": ["CAMERA", "READ_MEDIA_IMAGES"]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SnapStudy to access your camera to capture notes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SnapStudy to access your photos to import notes."
        }
      ],
      "expo-secure-store",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "supabaseUrl": "",
      "supabaseAnonKey": ""
    }
  }
}
